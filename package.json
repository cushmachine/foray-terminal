{
  "name": "foray-terminal",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "build": "npm run typecheck && vite build",
    "icons": "node scripts/make-icons.mjs",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "deploy": "bash scripts/deploy.sh",
    "token": "bash scripts/token.sh",
    "test": "npx tsx --test src/__tests__/*.test.ts src/server/__tests__/*.test.ts",
    "test:e2e": "npx tsx src/e2e/e2e.test.ts",
    "test:keys": "npx tsx src/e2e/keys.e2e.test.ts",
    "test:visual": "playwright test"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.10",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^4.0.3",
    "express": "^5.1.0",
    "multer": "^2.3.0",
    "node-pty": "^1.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
