{
  "name": "nest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "icons": "node scripts/make-icons.mjs",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "deploy": "vite build && pm2 restart nest",
    "test": "npx tsx --test src/__tests__/*.test.ts src/server/__tests__/*.test.ts",
    "test:socket-and-sessions": "npx tsx src/__tests__/socket-and-sessions.test.ts",
    "test:file-panel": "npx tsx src/__tests__/file-panel.test.ts",
    "test:uploads": "npx tsx src/__tests__/uploads.test.ts",
    "test:ansi": "npx tsx src/__tests__/ansi.test.ts",
    "test:version": "npx tsx src/__tests__/version.test.ts",
    "test:layout": "npx tsx src/__tests__/layout.test.ts",
    "test:sessions-sort": "npx tsx src/__tests__/sessions-sort.test.ts",
    "test:visual-audit": "npx tsx src/__tests__/visual-audit.test.ts",
    "test:mobile": "npx tsx src/__tests__/mobile.test.ts",
    "test:protocol": "npx tsx src/server/__tests__/protocol.test.ts",
    "test:tmux-and-routing": "npx tsx src/server/__tests__/tmux-and-routing.test.ts",
    "test:files": "npx tsx src/server/__tests__/files.test.ts",
    "test:handoff": "npx tsx src/server/__tests__/handoff.test.ts",
    "test:handshake": "npx tsx src/server/__tests__/handshake.test.ts",
    "test:history": "npx tsx src/server/__tests__/history.test.ts",
    "test:e2e": "npx tsx src/e2e/e2e.test.ts",
    "test:keys": "npx tsx src/e2e/keys.e2e.test.ts",
    "test:visual": "playwright test"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.10",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^4.0.3",
    "express": "^5.1.0",
    "multer": "^2.3.0",
    "node-pty": "^1.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
